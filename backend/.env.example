# ==========================================
# CoinWestie Backend Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=development

# ------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------
# For Local Development (Local Postgres):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coinwebsite_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# For Cloud Hosting (Render / Railway / Supabase / Neon):
# Set DATABASE_URL directly (overrides DB_HOST/DB_PORT/etc.)
# DATABASE_URL=postgres://user:password@ep-sample-123456.eu-central-1.aws.neon.tech/coinwebsite_db?sslmode=require

# ------------------------------------------
# Security & CORS
# ------------------------------------------
JWT_SECRET=super_secret_jwt_key_coinwestie_enterprise_2026
# Allow multiple origins separated by commas (e.g., localhost and your Cloudflare production domain)
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com,https://www.yourdomain.com

# ------------------------------------------
# External Services & APIs
# ------------------------------------------
RELOADLY_CLIENT_ID=your_reloadly_client_id
RELOADLY_CLIENT_SECRET=your_reloadly_client_secret
RELOADLY_AUDIENCE=https://giftcards.reloadly.com
